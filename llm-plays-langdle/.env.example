# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — SWEDLE origin (start app first: npm run dev in repo root)
# BASE_URL=http://127.0.0.1:3000

# Optional — UTC calendar date YYYY-MM-DD (default: today UTC)
# DATE_KEY=2026-03-20

# Optional — Gemini model for in-Node Langdle play (default tries 2.5-flash, 2.0-flash, 1.5-flash)
# GEMINI_GAME_MODEL=gemini-2.5-flash

# Optional — TTS voice name (default Charon — male-presenting). Others: Fenrir, Puck, Kore, …
# GEMINI_TTS_VOICE=Charon

