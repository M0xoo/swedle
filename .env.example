# Copy to .env.local (never commit secrets).

# Firebase Admin — Firestore stats (daily solver count + score distribution).
# Paste the full JSON of a service account key (single line), or use a file path below.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Or point to a key file (local / server) — same JSON, no need to paste into env:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/your-project-firebase-adminsdk-xxxxx.json

# On GCP (e.g. Cloud Run) with workload identity, no JSON in env:
# Cloud Run sets K_SERVICE + GOOGLE_CLOUD_PROJECT — stats use ADC automatically.
# FIREBASE_USE_ADC=1   # optional extra opt-in for non-Cloud Run GCP hosts
# FIREBASE_PROJECT_ID=your-project-id   # if Firebase id != GOOGLE_CLOUD_PROJECT

# Optional: override canonical / OG base URL
# NEXT_PUBLIC_SITE_URL=https://swedle.mokh.xyz

# Verbose Firestore stats logs in production (always on in `next dev`)
# SWEDLE_STATS_LOG=1
